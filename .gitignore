# ─── Datarix monorepo top-level .gitignore ───
# Subprojects keep their own .gitignore files;
# this top-level one covers only workspace-wide entries.

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local secrets
.env
.env.local
*.env.local

# Common build / cache outputs
node_modules/
.next/
__pycache__/
*.pyc
.venv/
playwright-report/
test-results/
tsconfig.tsbuildinfo

# Backup files generated by this script
*.bak

# ─── Frontend .gitignore (merged, paths prefixed) ───
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
frontend/frontend/node_modules
frontend/frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
frontend/!.yarn/patches
frontend/!.yarn/plugins
frontend/!.yarn/releases
frontend/!.yarn/versions

# testing
frontend/frontend/coverage

# next.js
frontend/frontend/.next/
frontend/frontend/out/

# production
frontend/frontend/build

# misc
frontend/.DS_Store
frontend/*.pem

# debug
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# env files (can opt-in for committing if needed)
frontend/.env*

# vercel
frontend/.vercel

# typescript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Claude Code internal state
frontend/.claude/

# Screenshots
frontend/*.png

# ─── Backend .gitignore (merged, paths prefixed) ───
