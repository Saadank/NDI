# .env.prod.example — corrected
# Generate each secret with `openssl rand -base64 32` unless noted.
# chmod 600 .env.prod AFTER filling in.

# ---- App ----
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=info
FRONTEND_URL=https://YOUR_DOMAIN                   # e.g. https://datasharing.sa

# ---- Postgres (app DB) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datasharing_prod
POSTGRES_USER=datasharing_app
POSTGRES_PASSWORD=CHANGE_ME                        # openssl rand -base64 32

# ---- Postgres (Keycloak DB) ----
# The bootstrap SQL creates database `keycloak` and role `keycloak` with a placeholder
# password; on first compose up, run scripts/set-keycloak-db-password.sh once to set
# the real password. KC will then use the values below.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME                     # openssl rand -base64 32

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME                           # openssl rand -base64 32

# ---- MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME                         # openssl rand -hex 16
MINIO_SECRET_KEY=CHANGE_ME                         # openssl rand -base64 32
MINIO_BUCKET=datasharing-files
MINIO_SECURE=false                                 # internal network only

# ---- Keycloak ----
KEYCLOAK_HOSTNAME=auth.YOUR_DOMAIN                 # hostname only (no scheme)
KEYCLOAK_SERVER_URL=https://auth.YOUR_DOMAIN
KEYCLOAK_REALM=datasharing-prod
KEYCLOAK_CLIENT_ID=datasharing-backend
KEYCLOAK_CLIENT_SECRET=FILL_AFTER_REALM_CREATED
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME                  # openssl rand -base64 32

# ---- Email / SMTP ----
EMAIL_BACKEND=smtp
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=noreply@YOUR_DOMAIN
INVITATION_FROM_EMAIL=invitations@YOUR_DOMAIN

# ---- Super admin seed ----
SUPER_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=CHANGE_ME                     # openssl rand -base64 32

# ---- File limits ----
MAX_FILE_SIZE_BYTES=5368709120

# ---- Workers ----
WORKER_EXPIRY_CHECK_INTERVAL_MINUTES=60
WORKER_SLA_CHECK_INTERVAL_MINUTES=30
WORKER_NOTIFICATION_INTERVAL_MINUTES=5

# ---- CI/CD image control ----
# Set by the deploy workflow; default lets a manual `docker compose up` work.
GITHUB_REPO=your-github-org/DataSharing-1st
IMAGE_TAG=latest

# ---- Backups ----
BACKUP_BUCKET=datasharing-backups
COMPOSE_PROJECT_NAME=datasharing
