# App
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=info
FRONTEND_URL=https://YOUR_DOMAIN_HERE

# PostgreSQL — use secrets manager in prod, not plain env vars
POSTGRES_HOST=YOUR_POSTGRES_HOST
POSTGRES_PORT=5432
POSTGRES_DB=datasharing_prod
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD

# Redis
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=YOUR_MINIO_HOST:9000
MINIO_ACCESS_KEY=YOUR_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_SECRET_KEY
MINIO_BUCKET=datasharing-files
MINIO_SECURE=true

# Keycloak
KEYCLOAK_SERVER_URL=https://YOUR_KEYCLOAK_HOST
KEYCLOAK_REALM=datasharing-prod
KEYCLOAK_CLIENT_ID=datasharing-backend
KEYCLOAK_CLIENT_SECRET=YOUR_CLIENT_SECRET
KEYCLOAK_ADMIN_USER=YOUR_ADMIN_USER
KEYCLOAK_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Email — use real SMTP in prod
EMAIL_BACKEND=smtp
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=noreply@YOUR_DOMAIN
INVITATION_FROM_EMAIL=invitations@YOUR_DOMAIN

# Super Admin seed
SUPER_ADMIN_EMAIL=YOUR_SUPER_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=YOUR_VERY_STRONG_PASSWORD

# File limits
MAX_FILE_SIZE_BYTES=5368709120

# Workers
WORKER_EXPIRY_CHECK_INTERVAL_MINUTES=60
WORKER_SLA_CHECK_INTERVAL_MINUTES=30
WORKER_NOTIFICATION_INTERVAL_MINUTES=5
