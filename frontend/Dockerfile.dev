FROM node:20-alpine

RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json package-lock.json ./
# Use `npm install` (not `npm ci`) so the build self-heals when the lockfile
# drifts from package.json — common during active feature work. CI/prod can
# tighten back to `npm ci` once the lockfile is stable.
RUN npm install --no-audit --no-fund

COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["npm", "run", "dev"]
