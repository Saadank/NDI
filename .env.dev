# App
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datasharing_dev
POSTGRES_USER=dsplatform
POSTGRES_PASSWORD=dev_password_change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=datasharing-files
MINIO_SECURE=false

# Keycloak
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=datasharing-dev
KEYCLOAK_CLIENT_ID=datasharing-backend
KEYCLOAK_CLIENT_SECRET=dev-client-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Email (dev uses MailHog — no real emails sent)
EMAIL_BACKEND=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
EMAIL_FROM=noreply@datasharing.local
INVITATION_FROM_EMAIL=invitations@datasharing.local

# Super Admin seed
SUPER_ADMIN_EMAIL=superadmin@datasharing.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!

# File limits
MAX_FILE_SIZE_BYTES=5368709120

# Workers
WORKER_EXPIRY_CHECK_INTERVAL_MINUTES=60
WORKER_SLA_CHECK_INTERVAL_MINUTES=30
WORKER_NOTIFICATION_INTERVAL_MINUTES=1

# External pickup portal
FRONTEND_BASE_URL=http://localhost:8000
PICKUP_TOKEN_TTL_HOURS=72
PICKUP_TOKEN_MAX_DOWNLOADS=10
PICKUP_DOWNLOAD_URL_TTL_SECONDS=120
PICKUP_RATE_LIMIT_PER_MINUTE=30
